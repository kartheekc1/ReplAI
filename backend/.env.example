# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret   # from Supabase project settings → API → JWT settings

# --- Meta / Instagram ---
META_APP_ID=000000000000000
META_APP_SECRET=xxx
META_VERIFY_TOKEN=replyverse-webhook-verify
META_REDIRECT_URI=http://localhost:3000/dashboard/accounts/callback
META_GRAPH_BASE=https://graph.instagram.com

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# --- App ---
APP_NAME=ReplyVerse
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://replyverse.app
LOG_LEVEL=INFO

# --- Security ---
RATE_LIMIT_DEFAULT=120/minute
