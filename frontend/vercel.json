{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://replai-2.onrender.com/:path*"
    }
  ]
}
