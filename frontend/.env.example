# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Meta / Instagram OAuth (client-side redirect)
NEXT_PUBLIC_META_APP_ID=000000000000000
NEXT_PUBLIC_META_REDIRECT_URI=http://localhost:3000/dashboard/accounts/callback
